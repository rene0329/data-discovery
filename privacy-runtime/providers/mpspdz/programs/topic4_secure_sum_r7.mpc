# Generated fixed malicious three-party integer vector sum.
MAX_VECTOR = 8
party_values = [sint.get_input_from(party, size=MAX_VECTOR) for party in range(3)]
for lane in range(MAX_VECTOR):
    total = sum(party_values[party][lane] for party in range(3))
    print_ln_to(0, 'TOPIC4_SUM[%s]=%%s' % lane, total.reveal_to(0))
    print_ln_to(1, 'TOPIC4_SUM[%s]=%%s' % lane, total.reveal_to(1))
    print_ln_to(2, 'TOPIC4_SUM[%s]=%%s' % lane, total.reveal_to(2))
