    </dependencies>

    <!-- Maven 构建过程中使用的插件的定义 -->
    <build>
        <plugins>
            <!-- 运行 mvn package 时，spring-boot-maven-plugin 会将 Spring Boot 应用打包成一个可执行的 JAR 文件 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.example.PraApplication</mainClass>
                    <!-- classifier 让 Fat JAR 以 practice-server-1.0-SNAPSHOT-exec.jar 命名，
                         原始的薄 JAR (practice-server-1.0-SNAPSHOT.jar) 保留在本地仓库，
                         其他模块依赖 practice-server 时才能正确找到类 -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
