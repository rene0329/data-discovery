<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.mapper.SchedulingPlanMapper">
    <resultMap id="PlanMap" type="org.example.entity.SchedulingPlan">
        <id property="planId" column="plan_id"/>
        <result property="externalPlanId" column="external_plan_id"/>
        <result property="taskId" column="task_id"/>
        <result property="internalTaskId" column="internal_task_id"/>
        <result property="algorithmName" column="algorithm_name"/>
        <result property="algorithmVersion" column="algorithm_version"/>
        <result property="status" column="status"/>
        <result property="errorMessage" column="error_message"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="AssignmentMap" type="org.example.entity.SchedulingAssignment">
        <id property="assignmentId" column="assignment_id"/>
        <result property="planId" column="plan_id"/>
        <result property="datasetId" column="dataset_id"/>
        <result property="replicaId" column="replica_id"/>
        <result property="sourceNodeId" column="source_node_id"/>
        <result property="targetNodeId" column="target_node_id"/>
        <result property="action" column="action"/>
        <result property="status" column="status"/>
        <result property="errorMessage" column="error_message"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insertPlan" parameterType="org.example.entity.SchedulingPlan"
            useGeneratedKeys="true" keyProperty="planId">
        INSERT INTO scheduling_plan (
            external_plan_id, task_id, internal_task_id, algorithm_name, algorithm_version, status
        ) VALUES (
            #{externalPlanId}, #{taskId}, #{internalTaskId}, #{algorithmName}, #{algorithmVersion}, #{status}
        )
    </insert>

    <insert id="insertAssignment" parameterType="org.example.entity.SchedulingAssignment"
            useGeneratedKeys="true" keyProperty="assignmentId">
        INSERT INTO scheduling_assignment (
            plan_id, dataset_id, replica_id, source_node_id, target_node_id, action, status
        ) VALUES (
            #{planId}, #{datasetId}, #{replicaId}, #{sourceNodeId}, #{targetNodeId}, #{action}, #{status}
        )
    </insert>

    <select id="findByExternalPlanId" resultMap="PlanMap">
        SELECT * FROM scheduling_plan WHERE external_plan_id = #{externalPlanId}
    </select>

    <select id="findById" resultMap="PlanMap">
        SELECT * FROM scheduling_plan WHERE plan_id = #{planId}
    </select>

    <select id="listAssignments" resultMap="AssignmentMap">
        SELECT * FROM scheduling_assignment WHERE plan_id = #{planId} ORDER BY assignment_id
    </select>

    <sql id="PlanFilters">
        <where>
            <if test="query != null and query != ''">
                (LOCATE(#{query}, external_plan_id) &gt; 0
                OR LOCATE(#{query}, task_id) &gt; 0
                OR LOCATE(#{query}, algorithm_name) &gt; 0
                OR CAST(plan_id AS CHAR) = #{query}
                OR CAST(internal_task_id AS CHAR) = #{query})
            </if>
            <if test="status != null and status != ''">
                <choose>
                    <when test="status == 'FAILED'">
                        AND status IN ('FAILED', 'PARTIAL_COMPLETED')
                    </when>
                    <otherwise>
                        AND status = #{status}
                    </otherwise>
                </choose>
            </if>
        </where>
    </sql>

    <select id="listPlans" resultMap="PlanMap">
        SELECT * FROM scheduling_plan
        <include refid="PlanFilters"/>
        ORDER BY created_at DESC, plan_id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countPlans" resultType="long">
        SELECT COUNT(*) FROM scheduling_plan
        <include refid="PlanFilters"/>
    </select>

    <update id="updatePlanStatus">
        UPDATE scheduling_plan
        SET status = #{status}, error_message = #{errorMessage}
        WHERE plan_id = #{planId}
    </update>

    <update id="updateAssignmentStatus">
        UPDATE scheduling_assignment
        SET status = #{status}, error_message = #{errorMessage}
        WHERE assignment_id = #{assignmentId}
    </update>
</mapper>
