package org.example.interceptor;

import io.jsonwebtoken.Claims;
import lombok.extern.slf4j.Slf4j;
import org.example.constant.JwtClaimsConstant;
import org.example.context.BaseContext;
import org.example.properties.JwtProperties;
import org.example.utils.JwtUtil;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;
import org.springframework.web.method.HandlerMethod;
import org.springframework.web.servlet.HandlerInterceptor;

import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

/**
 * jwt令牌校验的拦截器
 */
@Component
@Slf4j
public class JwtTokenAdminInterceptor implements HandlerInterceptor {

    @Autowired
    private JwtProperties jwtProperties;

    /**
     * 用于在请求处理之前进行拦截，通常用于权限检查、日志记录、数据验证等操作。
     */
    @Override
    public boolean preHandle(HttpServletRequest request, HttpServletResponse response, Object handler) throws Exception {
        // 1、判断当前拦截到的是 Controller 的方法还是其他资源
        /**
         * handler代表了处理当前请求的处理器（即 Spring MVC 中处理请求的目标对象）。
         * 通常情况下，这个 handler 是一个 HandlerMethod 对象，代表一个 @RequestMapping 注解标记的 Controller 方法。
         */
        if (!(handler instanceof HandlerMethod)) {
            // 放行
            return true;
        }

        // 2、从请求头中获取令牌
        String token = request.getHeader(jwtProperties.getAdminTokenName());

        // 3、校验令牌
        try {
            log.info("jwt校验：{}", token);
            Claims claims = JwtUtil.parseJWT(jwtProperties.getAdminSecretKey(), token);
            Long empId = Long.valueOf(claims.get(JwtClaimsConstant.EMP_ID).toString());

            // 通过线程 ThreadLocal 来设置 此次登录的员工，便于后期的工作：获取员工id
            BaseContext.setCurrentId(empId);

            log.info("当前员工id为：{}", empId);
            // 4、通过，放行
            return true;
        } catch (Exception ex) {
            // 5、不通过，响应401状态码（与前端约束的规则）
            response.setStatus(401);
            return false;
        }
    }
}
